# Portable SSD root for annual options matrices (Phase 2)
EXPORT_GAMMA_SQUEEZE_MATRIX_SSD_PATH=/Volumes/PortableSSD/Gamma Squeeze Matrix

# Feature / label / model artifact roots (defaults under platform data/ or SSD)
EXPORT_GAMMA_SQUEEZE_FEATURES_SSD_PATH=/Volumes/PortableSSD/Gamma Squeeze Matrix/features
EXPORT_GAMMA_SQUEEZE_MODELS_SSD_PATH=/Volumes/PortableSSD/Gamma Squeeze Matrix/models
EXPORT_GAMMA_SQUEEZE_FORECASTS_SSD_PATH=/Volumes/PortableSSD/Gamma Squeeze Matrix/forecasts

# Alpaca options matrix backup KV worker (annual history source)
ALPACA_BACKUP_WORKER_URL=https://alpaca-options-matrix-backup-empty-cherry-67dc.2s6m8rz8fc.workers.dev
CLOUDFLARE_ALPACA_OPTIONS_BACKUP_NAMESPACE_ID=e290dbe341d3496aac5e47d17042b3e5

# Sibling data-plane workers
OHLCV_KV_BASE_URL=https://ohcl-nasdaq-nameless-flower.2s6m8rz8fc.workers.dev
SKEW_IV_WORKER_URL=https://skew-3d-implied-volatility-shiny-darkness-9ebb.2s6m8rz8fc.workers.dev
FRED_WORKER_URL=https://fred-economic-data-icy-cloud-8332.2s6m8rz8fc.workers.dev
# Local / SSD mirror of Fred-Economic-data KV (one JSON file per series)
EXPORT_FRED_ECONOMIC_DATA_SSD_PATH=/Volumes/PortableSSD/Fred Economic data
CALENDAR_WORKER_URL=https://icy-poetry-6b0c.2s6m8rz8fc.workers.dev

# Optional / legacy: external data-plane package root (no longer required; GEX/Alpaca are vendored)
DATA_PLANE_ROOT=

# Cloudflare (optional: forecast KV upload / worker deploy)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_SQUEEZE_NAMESPACE_ID=
SQUEEZE_WORKER_URL=

# Market timezone for as-of anchoring
FORECAST_MARKET_TZ=America/New_York

# Platform YAML config (defaults + model backend map); env vars override
PLATFORM_CONFIG_PATH=
GLOBAL_SEED=42
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
REQUEST_TIMEOUT_SECONDS=30

# --- Canonical stack (Python 3.12+) ---
DATABASE_URL=postgresql://gamma:gamma@localhost:5432/gamma_squeeze
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
DUCKDB_PATH=/Volumes/PortableSSD/Gamma Squeeze Matrix/analytics/gamma.duckdb
MLFLOW_TRACKING_URI=http://localhost:5000

# Next.js dashboard (JSON panels — no HTML desk)
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_DASH_BASE=http://127.0.0.1:8011
NEXT_PUBLIC_WS_ALERTS=ws://127.0.0.1:8012/v1/ws/alerts

# --- Alpaca (tickers / options matrix / OHLCV) — paper trading endpoint ---
# Keys from https://app.alpaca.markets → API Keys (never commit real secrets)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_TRADING_API_BASE=https://paper-api.alpaca.markets/v2
ALPACA_DATA_API_BASE=https://data.alpaca.markets
ALPACA_OPTION_FEED=indicative

# Alert Engine channels (Email / SMS / Discord / Slack / Webhook)
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=alerts@gamma-squeeze.local
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_TWILIO_ACCOUNT_SID=
ALERT_TWILIO_AUTH_TOKEN=
ALERT_SMS_FROM=
ALERT_SMS_TO=
ALERT_DISCORD_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=

POLYGON_API_KEY=
FINNHUB_API_KEY=
CBOE_API_KEY=
OPRA_API_KEY=
OPRA_DATA_PATH=
IBKR_HOST=
IBKR_PORT=7497
IBKR_CLIENT_ID=1
