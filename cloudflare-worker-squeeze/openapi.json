{
  "openapi": "3.0.3",
  "info": {
    "title": "Gamma Squeeze Data API",
    "version": "1.0.0",
    "description": "Institutional gamma-squeeze research data from Cloudflare KV namespace `gamma-squeeze-data`.\n\nIncludes top-100 market-cap pipeline scans, per-symbol findings, and squeeze forecasts (1–10 trading days).\n\nImport OpenAPI into Base44 / API clients via `/openapi.json`.\n\nKV key layout (historical retained — never deleted by uploaders):\n- `index` — catalog\n- `scans/phase14_pipeline/latest` — latest universe pipeline findings\n- `scans/phase14_pipeline/findings` — compact findings array\n- `scans/phase14_pipeline/{YYYY-MM-DD}` — dated universe scan (date-only)\n- `scans/phase14_pipeline/by-date/{YYYY-MM-DD}/runs` — calendar-day run list\n- `{TICKER}/pipeline/latest` — per-symbol 14-stage findings\n- `{TICKER}/pipeline/summary` — compact squeeze summary\n- `{TICKER}/pipeline/{YYYY-MM-DD}` — dated pipeline (example: `AAPL/pipeline/2026-08-06`) — date-only, no `T153655Z`\n- `{TICKER}/latest` — latest SqueezeForecast (schema 1.0.0 + extracted_at)\n- `{TICKER}/forecast/{YYYY-MM-DD}` — dated forecast (example: `AAPL/forecast/2026-08-06`) — date-only, no `T061106Z` suffixes\n- `extractions/{YYYY-MM-DD}/index` — extraction index for that calendar day\n- `extractions/{YYYY-MM-DD}/runs` — day run list\n- `forecasts/index` — forecast catalog pointer\n"
  },
  "servers": [
    {
      "url": "https://gamma-squeeze-data-icy-shadow-db40.2s6m8rz8fc.workers.dev",
      "description": "Production Workers KV"
    }
  ],
  "tags": [
    { "name": "ops" },
    { "name": "scans" },
    { "name": "pipeline" },
    { "name": "forecasts" }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["ops"],
        "summary": "OpenAPI 3.0 document (root)",
        "operationId": "getOpenApiRoot",
        "responses": {
          "200": {
            "description": "OpenAPI 3.0.3 JSON",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["ops"],
        "summary": "OpenAPI 3.0 document",
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "description": "OpenAPI 3.0.3 JSON",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["ops"],
        "summary": "Health + KV binding status",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/retrievals": {
      "get": {
        "tags": ["ops"],
        "summary": "List retrievable operations",
        "operationId": "getRetrievals",
        "responses": {
          "200": { "description": "Retrieval catalog" }
        }
      }
    },
    "/v1/index": {
      "get": {
        "tags": ["ops"],
        "summary": "KV catalog index",
        "operationId": "getIndex",
        "responses": {
          "200": { "description": "Index JSON" }
        }
      }
    },
    "/v1/keys": {
      "get": {
        "tags": ["ops"],
        "summary": "List KV keys via env.KV (LIMIT 100)",
        "operationId": "listKvKeys",
        "parameters": [
          {
            "name": "prefix",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "AAPL/" }
          }
        ],
        "responses": {
          "200": { "description": "KV list results from bound namespace gamma-squeeze-data" }
        }
      }
    },
    "/v1/scans/phase14/latest": {
      "get": {
        "tags": ["scans"],
        "summary": "Latest top-100 × 14-stage pipeline scan",
        "operationId": "getPhase14ScanLatest",
        "responses": {
          "200": { "description": "Universe pipeline payload" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/scans/phase14/findings": {
      "get": {
        "tags": ["scans"],
        "summary": "Compact findings for top-100 universe",
        "operationId": "getPhase14Findings",
        "responses": {
          "200": { "description": "Findings array wrapper" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/scans/phase14/{date}": {
      "get": {
        "tags": ["scans"],
        "summary": "Phase14 scan by calendar day (YYYY-MM-DD)",
        "operationId": "getPhase14ScanDated",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "date", "example": "2026-08-06" }
          }
        ],
        "responses": {
          "200": { "description": "Dated universe pipeline payload" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/scans/phase14/by-date/{date}/runs": {
      "get": {
        "tags": ["scans"],
        "summary": "List phase14 calendar-day runs (YYYY-MM-DD only; no T153655Z)",
        "operationId": "getPhase14DayRuns",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "date", "example": "2026-08-06" }
          }
        ],
        "responses": {
          "200": { "description": "Day runs list with date-only run ids" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/{symbol}/pipeline/latest": {
      "get": {
        "tags": ["pipeline"],
        "summary": "Latest 14-stage pipeline findings for symbol",
        "operationId": "getSymbolPipelineLatest",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "AAPL" }
          }
        ],
        "responses": {
          "200": { "description": "Symbol pipeline findings" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/{symbol}/pipeline/summary": {
      "get": {
        "tags": ["pipeline"],
        "summary": "Compact 14-stage squeeze summary for symbol",
        "operationId": "getSymbolPipelineSummary",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "AAPL" }
          }
        ],
        "responses": {
          "200": { "description": "Pipeline summary" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/{symbol}/pipeline/{date}": {
      "get": {
        "tags": ["pipeline"],
        "summary": "Dated pipeline findings (YYYY-MM-DD only)",
        "operationId": "getSymbolPipelineDated",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "AAPL" }
          },
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-08-06",
              "description": "Calendar day key, e.g. AAPL/pipeline/2026-08-06"
            }
          }
        ],
        "responses": {
          "200": { "description": "Dated symbol pipeline findings" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/{symbol}/forecast/latest": {
      "get": {
        "tags": ["forecasts"],
        "summary": "Latest squeeze forecast for symbol",
        "operationId": "getSymbolForecastLatest",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "AAPL" }
          }
        ],
        "responses": {
          "200": { "description": "SqueezeForecast JSON" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/{symbol}/forecast/{date}": {
      "get": {
        "tags": ["forecasts"],
        "summary": "Dated squeeze forecast (YYYY-MM-DD only)",
        "operationId": "getSymbolForecastDated",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "AAPL" }
          },
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-08-06",
              "description": "Calendar day key, e.g. AAPL/forecast/2026-08-06"
            }
          }
        ],
        "responses": {
          "200": { "description": "SqueezeForecast JSON with extracted_at" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/extractions/{date}": {
      "get": {
        "tags": ["forecasts"],
        "summary": "Extraction index for a calendar day",
        "operationId": "getExtractionIndex",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "date", "example": "2026-08-06" }
          }
        ],
        "responses": {
          "200": { "description": "Extraction day index" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/extractions/{date}/runs": {
      "get": {
        "tags": ["forecasts"],
        "summary": "List extraction runs for a calendar day",
        "operationId": "getExtractionDayRuns",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "date", "example": "2026-08-06" }
          }
        ],
        "responses": {
          "200": { "description": "Day runs list" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/forecasts/index": {
      "get": {
        "tags": ["forecasts"],
        "summary": "Forecast catalog (latest extraction pointer)",
        "operationId": "getForecastsIndex",
        "responses": {
          "200": { "description": "Catalog" },
          "404": { "description": "Not found" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "openapi": { "type": "string", "example": "3.0.3" },
          "service": { "type": "string" },
          "binding": { "type": "string" },
          "namespace": { "type": "string" },
          "kv_connected": { "type": "boolean" },
          "openapi_url": { "type": "string" }
        }
      }
    }
  }
}
